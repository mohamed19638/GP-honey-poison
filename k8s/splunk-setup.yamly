apiVersion: v1
kind: Namespace
metadata:
  name: splunk
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: splunk-enterprise
  namespace: splunk
spec:
  replicas: 1
  selector:
    matchLabels:
      app: splunk
  template:
    metadata:
      labels:
        app: splunk
    spec:
      containers:
      - name: splunk
        image: splunk/splunk:latest
        env:
        - name: SPLUNK_START_ARGS
          value: "--accept-license"
        - name: SPLUNK_PASSWORD
          value: "Splunk@123" # ده الباسورد بتاعك
        ports:
        - containerPort: 8000 # بورت الـ UI (Dashboard)
        - containerPort: 9997 # بورت الـ Forwarder (استلام الداتا)
        - containerPort: 8089 # بورت الـ API
        resources:
          limits:
            memory: "2Gi"
            cpu: "1"
          requests:
            memory: "1Gi"
            cpu: "500m"
---
apiVersion: v1
kind: Service
metadata:
  name: splunk-service
  namespace: splunk
spec:
  selector:
    app: splunk
  ports:
  - name: ui
    protocol: TCP
    port: 8000
    targetPort: 8000
    nodePort: 30080 # هندخل منه من المتصفح
  - name: forwarder
    protocol: TCP
    port: 9997
    target_port: 9997
  type: NodePort
